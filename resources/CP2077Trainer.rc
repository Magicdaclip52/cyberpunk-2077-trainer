#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "CP2077Trainer.manifest"

IDI_APP_ICON ICON "app.ico"
IDR_PANEL_ART RCDATA "panel_art.bin"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,5,0
PRODUCTVERSION  0,2,5,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "CP2077Trainer"
            VALUE "FileDescription",  "Cyberpunk 2077 Trainer 2.5+"
            VALUE "FileVersion",      "0.2.5.0"
            VALUE "InternalName",     "CP2077Trainer"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "CP2077Trainer.exe"
            VALUE "ProductName",      "CP2077Trainer"
            VALUE "ProductVersion",   "0.2.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
